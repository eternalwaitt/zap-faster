<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.eternalwaitt.ZapFaster</id>
  <name>Zap Faster</name>
  <summary>A native WhatsApp client</summary>
  <developer id="io.github.eternalwaitt">
    <name>Zap Faster contributors</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT AND GPL-2.0-only</project_license>
  <description>
    <p>A native WhatsApp companion for Linux, macOS and Windows, written in Rust
    without a browser engine. Link your phone to read and send messages.</p>
    <p>Browse chats, search your local archive, send attachments and voice messages,
    and use emoji, GIFs and stickers. Closing the window can keep the connection
    running in the system tray. Zap Faster is an independent project, not affiliated
    with WhatsApp or Meta.</p>
  </description>
  <launchable type="desktop-id">io.github.eternalwaitt.ZapFaster.desktop</launchable>
  <url type="homepage">https://github.com/eternalwaitt/zap-faster/</url>
  <url type="bugtracker">https://github.com/eternalwaitt/zap-faster/issues</url>
  <url type="help">https://github.com/eternalwaitt/zap-faster/getting-started/</url>
  <url type="vcs-browser">https://github.com/eternalwaitt/zap-faster</url>
  <screenshots>
    <screenshot type="default">
      <caption>A conversation with pictures, voice messages and replies</caption>
      <image>https://raw.githubusercontent.com/eternalwaitt/zap-faster/main/docs/screenshot.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"><content_attribute id="social-chat">intense</content_attribute></content_rating>
  <requires>
    <display_length compare="ge">760</display_length>
    <internet>always</internet>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
